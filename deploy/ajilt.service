[Unit]
Description=Ajilt-AI chatbot + owner dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=ajilt
WorkingDirectory=/opt/ajilt
# One worker only: SQLite + the in-process calendar sync thread.
ExecStart=/opt/ajilt/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
