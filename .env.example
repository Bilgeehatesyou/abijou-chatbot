# ---------- Meta (Instagram + Facebook Page) ----------
# You choose this string yourself; you paste the same value into the Meta
# webhook setup screen as the "Verify Token".
META_VERIFY_TOKEN=pick-any-secret-string

# Page Access Token from the Meta app (Messenger/Instagram product settings).
META_PAGE_ACCESS_TOKEN=

# App Secret (Meta app > Settings > Basic). Used to verify webhook signatures.
# Leave blank to disable signature checking during local testing.
META_APP_SECRET=

# Graph API version. Check the current one in the Meta dashboard and set it here.
GRAPH_API_VERSION=v21.0

# ---------- LLM ----------
# Any OpenAI-compatible endpoint works.
# OpenAI (key from https://platform.openai.com/api-keys):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna
# LLM_REASONING_EFFORT=low
# LLM_FALLBACK_MODEL=
# Gemini (API key from https://aistudio.google.com/apikey):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Gemini 3 always thinks; "low" keeps chat replies fast. Leave empty for Ollama.
LLM_REASONING_EFFORT=low
# Backup model when the main one is overloaded (503) or slower than LLM_PRIMARY_TIMEOUT seconds.
# Chat replies only; data generation always waits for LLM_MODEL.
LLM_FALLBACK_MODEL=gemini-3.6-flash
LLM_PRIMARY_TIMEOUT=15
# Local Ollama for testing instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b
# LLM_API_KEY=ollama
# LLM_REASONING_EFFORT=
# Set to false to run with zero LLM calls (keyword matching only).
LLM_ENABLED=true

# ---------- Booking (Google Calendar) ----------
# Service account JSON key (Google Cloud > IAM > Service Accounts > Keys). Never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Demo calendars are created by the service account and shared with this Google account.
BOOKING_CALENDAR_SHARE_WITH=
BOOKING_TIMEZONE=Asia/Ulaanbaatar

# ---------- Owner dashboard (/dashboard) ----------
# Browser login for the dashboard. Leave the password empty only when running locally.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ---------- App ----------
# demo  = FAQ demo for 10 fictional businesses (python -m app.demo_data load first)
# sales = Ajilt-AI sales qualification + quote flow
BOT_MODE=demo
# Public https address of this app, for product-card images in Messenger carousels.
# Not needed on Vercel (it provides VERCEL_PROJECT_PRODUCTION_URL). Locally: your ngrok URL.
PUBLIC_BASE_URL=
BOT_NAME=Ajilt-AI
DB_PATH=ajilt.db
PRICING_PATH=config/pricing.yaml
