# ---------- LLM ----------
# Any OpenAI-compatible endpoint works. Without a model the bot still runs: menus,
# prices and booking work, and free questions are matched to the FAQ by keywords.
# Gemini (API key from https://aistudio.google.com/apikey):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# Gemini 3 always thinks; "low" keeps chat replies fast. Leave empty for Ollama.
LLM_REASONING_EFFORT=low
# Backup model when the main one is overloaded (503) or slower than LLM_PRIMARY_TIMEOUT seconds.
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_PRIMARY_TIMEOUT=10
# OpenAI instead:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna
# Set to false to run with zero LLM calls (keyword matching only).
LLM_ENABLED=true

# ---------- Meta (Instagram + Facebook Page) ----------
# You choose this string yourself; paste the same value into Meta's webhook setup.
META_VERIFY_TOKEN=pick-any-secret-string
# Page Access Token from the Meta app (Messenger/Instagram product settings).
META_PAGE_ACCESS_TOKEN=
# App Secret (Meta app > Settings > Basic). Leave blank to skip signature checks locally.
META_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ---------- Booking ----------
# Optional Google Calendar: bookings also land in one shared calendar, and events staff
# add there by hand block those times. Without it bookings live in our database (/bookings).
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
BOOKING_CALENDAR_SHARE_WITH=
BOOKING_TIMEZONE=Asia/Ulaanbaatar
# Online deposits (app/payment.py). Not built yet: keep false.
PAYMENT_ENABLED=false

# ---------- Staff ----------
# Login for /bookings. Leave the password empty only when running locally.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Telegram alert to the clinic for every new booking. Empty = no alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret for an n8n workflow calling /api/n8n (sent as X-Bot-Token). Empty = off.
N8N_TOKEN=

# ---------- Web chat ----------
# The clinic's website, if it embeds the chat (the /chat demo page needs nothing here).
WEB_CHAT_ORIGINS=
WEB_CHAT_PER_10MIN=25
WEB_CHAT_PER_DAY=300

# ---------- App ----------
BOT_NAME=Abijou Clinic
DB_PATH=abijou.db
