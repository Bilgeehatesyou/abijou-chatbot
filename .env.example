# ---------- Meta (Instagram + Facebook Page) ----------
# You choose this string yourself; you paste the same value into the Meta
# webhook setup screen as the "Verify Token".
META_VERIFY_TOKEN=pick-any-secret-string

# Page Access Token from the Meta app (Messenger/Instagram product settings).
META_PAGE_ACCESS_TOKEN=

# App Secret (Meta app > Settings > Basic). Used to verify webhook signatures.
# Leave blank to disable signature checking during local testing.
META_APP_SECRET=

# Graph API version. Check the current one in the Meta dashboard and set it here.
GRAPH_API_VERSION=v21.0

# ---------- LLM ----------
# Any OpenAI-compatible endpoint works.
# OpenAI (key from https://platform.openai.com/api-keys):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna
# LLM_REASONING_EFFORT=low
# LLM_FALLBACK_MODEL=
# Gemini (API key from https://aistudio.google.com/apikey):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=
# Gemini 3 always thinks; "low" keeps chat replies fast. Leave empty for Ollama.
LLM_REASONING_EFFORT=low
# Backup model when the main one is overloaded (503) or slower than LLM_PRIMARY_TIMEOUT seconds.
# Chat replies only; data generation always waits for LLM_MODEL.
LLM_FALLBACK_MODEL=gemini-3.6-flash
LLM_PRIMARY_TIMEOUT=15
# Local Ollama for testing instead:
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=gemma3:4b
# LLM_API_KEY=ollama
# LLM_REASONING_EFFORT=
# Set to false to run with zero LLM calls (keyword matching only).
LLM_ENABLED=true

# ---------- Booking (Google Calendar) ----------
# Service account JSON key (Google Cloud > IAM > Service Accounts > Keys). Never commit it.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Demo calendars are created by the service account and shared with this Google account.
BOOKING_CALENDAR_SHARE_WITH=
BOOKING_TIMEZONE=Asia/Ulaanbaatar

# ---------- Owner dashboard (/dashboard) ----------
# Browser login for the dashboard. Leave the password empty only when running locally.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
# Shared secret for meetings posted by the ajiltai.tech booking form (/api/site-booking).
# Put the same value in the website's config.php as AJILT_TOKEN. Empty = endpoint off.
SITE_BOOKING_TOKEN=
# Shared secret for the n8n workflow that receives Meta's webhook and calls /api/n8n
# (sent as X-Ajilt-Token). Empty = endpoint off.
N8N_TOKEN=

# ---------- Website chat bubble (/api/chat) ----------
# Sites allowed to call the chat endpoint from a browser. Empty = endpoint off.
WEB_CHAT_ORIGINS=https://ajiltai.tech,https://www.ajiltai.tech
# Per visitor IP (hashed), so a stranger can't burn through the model budget.
WEB_CHAT_PER_10MIN=25
WEB_CHAT_PER_DAY=300

# ---------- App ----------
# demo  = FAQ demo for 10 fictional businesses (python -m app.demo_data load first)
# sales = Ajilt-AI sales qualification + quote flow
BOT_MODE=demo
# Public https address of this app, for product-card images in Messenger carousels.
# Not needed on Vercel (it provides VERCEL_PROJECT_PRODUCTION_URL). Locally: your ngrok URL.
PUBLIC_BASE_URL=
BOT_NAME=Ajilt-AI
DB_PATH=ajilt.db
PRICING_PATH=config/pricing.yaml

# ---------- bas.mn (Perfex CRM) ----------
# Where leads, bookings and orders are written. Empty = keep them in our own
# database only. Key: bas.mn > API > Users Management (it needs leads get/post/put,
# calendar get/post/put/delete, items get, staffs get). Test it: python -m app.crm check
BASMN_URL=https://aibiz.bas.mn
BASMN_API_KEY=
# Ids from bas.mn > Setup > Leads > Statuses / Sources and Setup > Staff.
# Defaults are aibiz.bas.mn's (status 1 there is "Customer": never use it for new leads).
BASMN_STATUS_NEW=2
# Optional: a status for "meeting booked" / "meeting cancelled" (create them in bas.mn
# first). Empty = the lead keeps its status.
BASMN_STATUS_MEETING=
BASMN_STATUS_CANCELLED=
BASMN_SOURCE_FACEBOOK=2
# Empty = Instagram leads use the Facebook source. Add an "Instagram" source in bas.mn
# and put its id here to tell them apart.
BASMN_SOURCE_INSTAGRAM=
BASMN_SOURCE_WEBSITE=3
BASMN_ASSIGNED=1
# When bas.mn gets a custom table for orders, its name. Empty = orders are leads only.
BASMN_ORDERS_TABLE=
# Seconds between reads of bas.mn (calendar changes, prices in Items).
BASMN_PULL_SECONDS=300
# Serverless only (Vercel): a scheduler calls /api/basmn/sync with
# "Authorization: Bearer <this>". Vercel Cron sends it by itself. Empty = endpoint off.
CRON_SECRET=
